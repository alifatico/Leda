# ──────────────────────────────────────────────────────────────────────────────
# Preventivo Lampo — configuration
# Only STRIPE_SECRET_KEY is required to start selling. Everything else is optional.
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of the deployment (no trailing slash). On Vercel this is detected
# automatically from VERCEL_PROJECT_PRODUCTION_URL, so you can leave it empty.
APP_URL=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… while testing, sk_live_… to earn.
STRIPE_SECRET_KEY=

# Optional: use Prices you created in the Stripe dashboard instead of ad-hoc
# price_data (recommended once you go live, keeps the dashboard tidy).
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Amounts in cents, used when no Price ID is configured. Defaults: 4,90 € / 9 € / 59 €
PRICE_CURRENCY=eur
PRICE_SINGLE_CENTS=490
PRICE_PRO_MONTHLY_CENTS=900
PRICE_PRO_YEARLY_CENTS=5900

# Customer Portal configuration to use for "Gestisci abbonamento" (bpc_…). Leave
# empty to use the default configuration saved in the Stripe dashboard.
STRIPE_PORTAL_CONFIGURATION=

# Stripe Tax (needs to be activated in the dashboard first). 0/1
STRIPE_AUTOMATIC_TAX=0
# Let business customers enter their VAT number at checkout. Default on.
STRIPE_COLLECT_TAX_ID=1

# Secret used to sign licence/unlock tokens. If empty it is derived from the
# Stripe key. Set an explicit random value (openssl rand -hex 32) if you ever
# rotate the Stripe key and want existing licences to keep working.
LICENSE_SECRET=

# ── "Invia al cliente" with online acceptance (optional, needs a key-value store) ──
# Vercel → Storage → Upstash Redis injects these automatically. Any Upstash
# Redis database works (free tier is plenty). Without them the feature is hidden.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV variable names are also accepted: KV_REST_API_URL / KV_REST_API_TOKEN
# Local development only: keep shared quotes in memory (lost on restart).
# SHARE_STORE=memory

# ── AI draft (optional) ───────────────────────────────────────────────────────
# Without a key the "AI draft" button explains the feature is not enabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Hard cap of AI drafts per day across all users (cost control). Default 400.
AI_DAILY_LIMIT=400

# ── Client lookup in the business register (optional) ─────────────────────────
# Two providers; without any token the client field only suggests the clients
# already used in this browser.
#
# Default, no token needed: the EU VAT register (VIES). Typing a VAT number
# fills name and registered office in under a second; names cannot be searched
# and only companies enrolled for intra-EU trade are listed.
#
# A) Apify actor, only with COMPANY_LOOKUP=apify (slow: every search is a run
#    of tens of seconds; pay per result, free plan with $5/month, no card): the field
#    gets a "Cerca nel Registro Imprese" button, each search is a run of some
#    seconds (~$0.03 for 5 results). Token: console.apify.com → Settings → API.
APIFY_TOKEN=
# Actor as "username~name"; results per search (each one is paid); run timeout (s).
APIFY_COMPANY_ACTOR=jungle_synthesizer~italy-registroimprese-bilanci-scraper
APIFY_COMPANY_MAX_ITEMS=5
APIFY_COMPANY_TIMEOUT=120
#
# B) openapi.com (instant name search; real-time API, prepaid wallet, €50 minimum top-up): suggestions
#    while typing, ~€0.001 per autocomplete call and €0.015 per full card.
#    Token from console.openapi.com with the "company" scope (IT-search + IT-start).
OPENAPI_COMPANY_TOKEN=
# Use the sandbox (test.company.openapi.com, fake data) instead of production. 0/1
OPENAPI_COMPANY_SANDBOX=0
#
# Provider: vies (default) | openapi (picked by itself when its token is set) | apify (only if set here) | mock | off
# COMPANY_LOOKUP=apify
# Force the UI: autocomplete (while typing) | on-demand (button). Defaults: openapi → autocomplete, apify → on-demand.
# COMPANY_LOOKUP_MODE=on-demand
# Hard cap of paid lookups per day across all users (cost control). Default 300 with Apify, 2000 with openapi.
COMPANY_LOOKUP_DAILY_LIMIT=300
# Local development only: five canned companies, no token needed (COMPANY_LOOKUP_MODE=on-demand to try the button).
# COMPANY_LOOKUP=mock

# ── E-mail for licence recovery (optional, resend.com) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Preventivo Lampo <noreply@yourdomain.it>"

# ── Legal / branding (shown in footer, privacy and terms pages) ───────────────
BUSINESS_NAME=Preventivo Lampo
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_VAT=
SUPPORT_EMAIL=

# ── Analytics / SEO (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console → Verifica con tag HTML → il valore di "content"
GOOGLE_SITE_VERIFICATION=
